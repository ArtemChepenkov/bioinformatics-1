digraph pipeline {
  rankdir=TB;
  graph [fontname="Helvetica", labelloc="t", label="Пайплайн HW3 (GNU make) — DAG зависимостей"];
  node  [fontname="Helvetica", fontsize=10];
  edge  [color="#555555"];
  "all" [shape=ellipse, style="rounded,filled", fillcolor="#d7ecd9"];
  "reads/sample_1.fastq.gz" [shape=box, style="rounded,filled", fillcolor="#fdf3d0"];
  "reads/sample_2.fastq.gz" [shape=box, style="rounded,filled", fillcolor="#fdf3d0"];
  "ref/ecoli.fa" [shape=box, style="rounded,filled", fillcolor="#fdf3d0"];
  "ref/ecoli.fa.bwt" [shape=box, style="rounded,filled", fillcolor="#e8eef7"];
  "ref/ecoli.fa.fai" [shape=box, style="rounded,filled", fillcolor="#e8eef7"];
  "results/fastqc/.done" [shape=box, style="rounded,filled", fillcolor="#e8eef7"];
  "results/sample.FINISHED" [shape=box, style="rounded,filled", fillcolor="#f6d6d6"];
  "results/sample.bam" [shape=box, style="rounded,filled", fillcolor="#e8eef7"];
  "results/sample.flagstat.txt" [shape=box, style="rounded,filled", fillcolor="#e8eef7"];
  "results/sample.mapped_pct.txt" [shape=box, style="rounded,filled", fillcolor="#e8eef7"];
  "results/sample.qc_status.txt" [shape=box, style="rounded,filled", fillcolor="#e8eef7"];
  "results/sample.sam" [shape=box, style="rounded,filled", fillcolor="#e8eef7"];
  "results/sample.sorted.bam" [shape=box, style="rounded,filled", fillcolor="#e8eef7"];
  "results/sample.vcf" [shape=box, style="rounded,filled", fillcolor="#f6d6d6"];
  "results/sample.FINISHED" -> "all";
  "ref/ecoli.fa" -> "ref/ecoli.fa.bwt";
  "ref/ecoli.fa" -> "ref/ecoli.fa.fai";
  "reads/sample_1.fastq.gz" -> "results/fastqc/.done";
  "reads/sample_2.fastq.gz" -> "results/fastqc/.done";
  "results/fastqc/.done" -> "results/sample.FINISHED";
  "results/sample.vcf" -> "results/sample.FINISHED";
  "results/sample.sam" -> "results/sample.bam";
  "results/sample.bam" -> "results/sample.flagstat.txt";
  "results/sample.flagstat.txt" -> "results/sample.mapped_pct.txt";
  "results/sample.mapped_pct.txt" -> "results/sample.qc_status.txt";
  "reads/sample_1.fastq.gz" -> "results/sample.sam";
  "reads/sample_2.fastq.gz" -> "results/sample.sam";
  "ref/ecoli.fa.bwt" -> "results/sample.sam";
  "results/sample.bam" -> "results/sample.sorted.bam";
  "results/sample.qc_status.txt" -> "results/sample.sorted.bam";
  "ref/ecoli.fa.fai" -> "results/sample.vcf";
  "results/sample.sorted.bam" -> "results/sample.vcf";
}
